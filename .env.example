# BinPulse frontend environment variables (copy to .env.local and adjust).

# Base URL of the smart-dustbin backend that drives the live fleet.
# Defaults to the running demo backend if unset (see src/data/api.js).
# NOTE: the backend is HTTP-only. A browser on an HTTPS page (e.g. GitHub Pages)
# will block requests to an http:// backend (mixed content); serve the backend
# over HTTPS, or run the frontend over http://localhost for live data.
VITE_API_BASE=http://37.27.53.14:8031

# Google Maps JavaScript API key (optional; enables the keyed map/Street View path).
# VITE_GOOGLE_MAPS_API_KEY=
